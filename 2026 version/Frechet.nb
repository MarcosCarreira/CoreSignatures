          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", "1", "}"}]}], "]"}], "&"}], ",", 
          RowBox[{"Transpose", "[", "results", "]"}]}], "]"}], ",", 
