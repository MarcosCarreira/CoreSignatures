          RowBox[{"Function", "[", 
           RowBox[{"t", ",", "#"}], "]"}], "&"}], ",", "dpaths", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"integrands", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{"Tuples", ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
