               SubscriptBox["t", 
                RowBox[{"j", "+", "1"}]]}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "level"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"iassump", "=", 
       RowBox[{"Fold", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#1", "&&", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"limits", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "<=", 
              SubscriptBox["t", "#2"], "<=", 
              RowBox[{"limits", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ")"}], "&"}], ",", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"limits", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<=", 
