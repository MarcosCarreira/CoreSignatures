Cell[BoxData[
 RowBox[{
  RowBox[{"filterbounds", "[", 
   RowBox[{"bump_", ",", "limitfirst_", ",", "limitlast_", ",", 
    RowBox[{"eps_", ":", "0.5"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "newbump", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newbump", "=", "bump"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"newbump", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bump", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"eps", "*", "limitfirst"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"newbump", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", 
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"bump", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"eps", "*", "limitlast"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "newbump"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.946315185177135*^9, 3.946315395502151*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"5628916c-dff7-4654-9626-ad9e88623374"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mutate", "[", 
    RowBox[{"pts_", ",", "\[Sigma]_", ",", "copies_", ",", 
     RowBox[{"eps_", ":", "0.5"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "first", ",", "mid", ",", "last", ",", "limitfirst", ",", "limitlast", ",",
        "bumps", ",", "newmid"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"first", "=", 
       RowBox[{"First", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"last", "=", 
       RowBox[{"Last", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mid", "=", 
       RowBox[{"Rest", "[", 
        RowBox[{"Most", "[", "pts", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"limitfirst", "=", 
       RowBox[{
        RowBox[{"first", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"First", "[", "mid", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"limitlast", "=", 
       RowBox[{
        RowBox[{"last", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"Last", "[", "mid", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bumps", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", "\[Sigma]"}], "]"}], ",", 
           RowBox[{"Dimensions", "[", "mid", "]"}]}], "]"}], ",", 
         RowBox[{"{", "copies", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"bumps", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"filterbounds", "[", 
           RowBox[{"#", ",", "limitfirst", ",", "limitlast", ",", "eps"}], 
           "]"}], "&"}], ",", "bumps"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"newmid", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"mid", "+", "#"}], ")"}], "&"}], ",", "bumps"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Prepend", "[", 
          RowBox[{
