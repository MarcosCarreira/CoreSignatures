           RowBox[{"limits", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ")"}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{"2", ",", "level"}], "]"}]}], "]"}]}], ";", 
