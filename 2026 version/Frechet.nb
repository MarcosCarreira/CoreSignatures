            ",", 
           RowBox[{"integrands", "[", 
            RowBox[{"[", "k", "]"}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "level"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Map", "[", 
       RowBox[{"tensorfold", ",", 
        RowBox[{"Map", "[", 
