                RowBox[{"{", "2", "}"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "level"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
